# ─────────────────────────────────────────────────────────────
# ONZE server configuration
# Copy to server/.env (or export in your shell) and fill in.
# ─────────────────────────────────────────────────────────────

# HTTP port for the backend
PORT=8787

# SQLite database file (relative to /server). The game state stored
# here is the single source of truth.
DATABASE_FILE=./data/onze.db

# ─── LLM inference (the conversation layer) ──────────────────
# The API is provided separately. Until a key is set, the server
# falls back to a deterministic MOCK persona engine so the full
# game loop stays playable end-to-end with no external calls.
#
# Provider-agnostic OpenAI-compatible chat-completions contract:
#   POST {LLM_BASE_URL}/chat/completions  (Bearer {LLM_API_KEY})
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER=anthropic

# Model routing: a cheap default model for ordinary turns, a
# stronger one reserved for key beats (offers, big press moments).
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-opus-4-8

# Force the mock engine even when a key is present (useful for tests/demo).
LLM_FORCE_MOCK=false
