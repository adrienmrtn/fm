{
  "name": "@onze/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/seedCli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@onze/shared": "*",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
