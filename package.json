{
  "name": "onze",
  "version": "0.1.0",
  "private": true,
  "description": "ONZE — AI-driven solo football career RPG",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @onze/server",
    "dev:client": "npm run dev -w @onze/client",
    "build": "npm run build -w @onze/client",
    "test": "npm run test -w @onze/server",
    "seed": "npm run seed -w @onze/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
